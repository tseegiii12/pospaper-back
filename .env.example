DATABASE_URL="postgresql://pospaper:pospaper@localhost:5433/pospaper?schema=public"
DIRECT_URL="postgresql://pospaper:pospaper@localhost:5433/pospaper?schema=public"
PORT=4000
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:3000"

# Set to "true" only if deployed behind a reverse proxy/load balancer (e.g. nginx),
# so rate limiting reads the real client IP from X-Forwarded-For instead of being spoofable.
TRUST_PROXY="false"

# Google Sign-In - OAuth 2.0 Client ID from Google Cloud Console
GOOGLE_CLIENT_ID=""

# Email (SMTP) - fill in once you have provider credentials
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
